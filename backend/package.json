{
  "name": "skilbridge-backend",
  "version": "1.0.0",
  "description": "Backend API for SkilBridge - Evidence-Based Career Re-entry Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
